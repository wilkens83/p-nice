<section class="features-grid section-padding">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="features-grid__header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="features-grid__eyebrow eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 class="features-grid__heading">{{ section.settings.heading }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p class="features-grid__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ul class="features-grid__list list-unstyled" role="list">
      {%- for block in section.blocks -%}
        <li class="features-grid__item" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != blank -%}
            <div class="features-grid__icon" aria-hidden="true">{{ block.settings.icon }}</div>
          {%- endif -%}
          {%- if block.settings.number != blank -%}
            <div class="features-grid__number" aria-hidden="true">{{ block.settings.number }}</div>
          {%- endif -%}
          {%- if block.settings.heading != blank -%}
            <h3 class="features-grid__item-heading">{{ block.settings.heading }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <p class="features-grid__item-text">{{ block.settings.text }}</p>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Features grid",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Why Sleep Plus Works"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Crafted for Your Best Skin and Best Rest"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Nourishment, protection, and a natural glow — all in one overnight routine."
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (emoji or text symbol)",
          "default": "💧"
        },
        {
          "type": "text",
          "id": "number",
          "label": "Number (optional, e.g. (1))",
          "info": "Shows instead of icon if both are filled — leave blank to use icon only"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Feature heading",
          "default": "Hydrating Formula"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Feature description",
          "default": "Enriched with Hyaluronic Acid — nature's Moisture Miracle — to keep skin supple and hydrated throughout the night."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Features grid",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "icon": "💧",
            "heading": "Hydrating Formula",
            "text": "Enriched with Hyaluronic Acid — nature's Moisture Miracle — to keep skin supple and hydrated throughout the night."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "✨",
            "heading": "Collagen Infused",
            "text": "Helps maintain skin elasticity and smooth appearance with restorative overnight Collagen benefits."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "🌿",
            "heading": "Natural Oils",
            "text": "Avocado Oil and Lavender Oil soothe and moisturize, leaving skin soft and refreshed by morning."
          }
        }
      ]
    }
  ]
}
{% endschema %}
