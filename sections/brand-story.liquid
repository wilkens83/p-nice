<section class="brand-story section-padding">
  <div class="brand-story__inner page-width brand-story__layout--{{ section.settings.image_position }}">
    {%- if section.settings.image != blank -%}
      <div class="brand-story__media">
        {{ section.settings.image | image_url: width: 800 | image_tag:
          loading: 'lazy',
          widths: '300, 400, 600, 800',
          class: 'brand-story__image'
        }}
      </div>
    {%- else -%}
      <div class="brand-story__media brand-story__media--placeholder">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      </div>
    {%- endif -%}

    <div class="brand-story__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="brand-story__eyebrow eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="brand-story__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="brand-story__text rte">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a
          href="{{ section.settings.button_link | default: routes.root_url }}"
          class="button button--secondary brand-story__button"
        >
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brand story",
  "settings": [
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Our Story"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Sleep Better. Wake Up Radiant."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Body text",
      "default": "P-nice Wellness Sleep Plus Collagen Cream is an investment for your skin and your sleep. With bio-identical Melatonin, Collagen, and Hyaluronic Acid — our gentle formula works overnight to restore elasticity, hydrate deeply, and leave your skin feeling refreshed by morning. Suitable for all skin types. Made in the USA."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Brand story"
    }
  ]
}
{% endschema %}
