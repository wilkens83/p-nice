<section class="science-facts section-padding">
  <div class="page-width">
    <div class="science-facts__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="science-facts__eyebrow eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="science-facts__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="science-facts__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <ul class="science-facts__list list-unstyled" role="list">
        {%- for block in section.blocks -%}
          <li class="science-facts__card" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != blank -%}
              <div class="science-facts__card-icon" aria-hidden="true">{{ block.settings.icon }}</div>
            {%- endif -%}
            <div class="science-facts__card-body">
              {%- if block.settings.title != blank -%}
                <h3 class="science-facts__card-title">{{ block.settings.title }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="science-facts__card-text">{{ block.settings.text }}</p>
              {%- endif -%}
              {%- if block.settings.citation != blank -%}
                <p class="science-facts__card-citation caption">{{ block.settings.citation }}</p>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Science facts",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Research-Backed"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Science Behind Sleep Plus"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Every claim is backed by peer-reviewed research."
    }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "Research fact",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (emoji)",
          "default": "🌙"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Fact title",
          "default": "Bio-Identical Melatonin"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Fact description",
          "default": "Described as the \"sleep hormone,\" melatonin declines with age. Supplementation can help reset the body's circadian rhythm, restoring restful sleep."
        },
        {
          "type": "text",
          "id": "citation",
          "label": "Research citation",
          "default": ""
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Science facts",
      "blocks": [
        {
          "type": "fact",
          "settings": {
            "icon": "🌙",
            "title": "Bio-Identical Melatonin",
            "text": "Described as the \"sleep hormone,\" melatonin declines with age. Topical melatonin helps reset the body's natural rhythm and acts as a powerful skin antioxidant.",
            "citation": ""
          }
        },
        {
          "type": "fact",
          "settings": {
            "icon": "📋",
            "title": "Improves Sleep Onset & Duration",
            "text": "A 2022 systematic review and meta-analysis demonstrates that melatonin supplementation significantly enhances sleep onset latency and total sleep time among individuals with sleep disorders.",
            "citation": "Journal of Neurology, 2022 — Randomized Controlled Trial Meta-Analysis"
          }
        },
        {
          "type": "fact",
          "settings": {
            "icon": "🧬",
            "title": "Anti-Aging Skin Benefits",
            "text": "Topically applied melatonin is a safe and effective skincare ingredient with antioxidant and anti-inflammatory properties, showing potential for photoprotection, anti-aging, and skin renewal.",
            "citation": "Peer-reviewed dermatology study — Topical Melatonin Research"
          }
        }
      ]
    }
  ]
}
{% endschema %}
