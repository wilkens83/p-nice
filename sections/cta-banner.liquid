<section class="cta-banner" style="background-color: {{ section.settings.bg_color }};">
  <div class="cta-banner__inner page-width">
    {%- if section.settings.quote != blank -%}
      <p class="cta-banner__quote">{{ section.settings.quote }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="cta-banner__heading" style="color: {{ section.settings.heading_color }};">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    {%- if section.settings.subtext != blank -%}
      <p class="cta-banner__subtext" style="color: {{ section.settings.text_color }};">
        {{ section.settings.subtext }}
      </p>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <a
        href="{{ section.settings.button_link | default: routes.root_url }}"
        class="button cta-banner__button"
        style="background-color: {{ section.settings.button_bg }}; color: {{ section.settings.button_text_color }};"
      >
        {{ section.settings.button_label }}
      </a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "CTA banner",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#F8F4EE"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1A1A1A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#6D6D6D"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button background",
      "default": "#2D5A3D"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#FFFFFF"
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Italic quote (optional)",
      "default": "Nourish your skin while you sleep."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main heading",
      "default": "Wake Up to the Best Version of Your Skin."
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "Join thousands of customers who trust P-nice Wellness for their nighttime skincare routine."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "SHOP SLEEP PLUS COLLAGEN CREAM"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "CTA banner"
    }
  ]
}
{% endschema %}
