{% comment %}
  Renders a product card.

  Accepts:
  - card_product: {Object} Product object
  - lazy_load: {Boolean} Use lazy loading on images (default: true)

  Usage:
  {% render 'card-product', card_product: product %}
{% endcomment %}

{%- unless card_product == blank -%}
  <div class="card-wrapper">
    <article class="card card--product" aria-label="{{ card_product.title | escape }}">
      <div class="card__inner">
        <a href="{{ card_product.url }}" class="card__link">
          <div class="card__media">
            {%- if card_product.featured_media -%}
              {{ card_product.featured_media | image_url: width: 500 | image_tag:
                lazy_load: lazy_load | default: true,
                widths: '200, 300, 400, 500',
                class: 'motion-reduce'
              }}
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
        </a>

        {%- if card_product.compare_at_price > card_product.price -%}
          <div class="card__badge">
            <span class="badge badge--bottom-left">{{ 'products.product.sale_badge' | t }}</span>
          </div>
        {%- endif -%}
      </div>

      <div class="card__content">
        <div class="card__information">
          <h3 class="card__heading">
            <a href="{{ card_product.url }}" class="full-unstyled-link">
              {{ card_product.title | escape }}
            </a>
          </h3>

          <div class="card__price">
            {%- if card_product.price_varies -%}
              <span class="price">{{ 'products.general.from' | t: price: card_product.price_min | money }}</span>
            {%- else -%}
              <span class="price">{{ card_product.price | money }}</span>
            {%- endif -%}
            {%- if card_product.compare_at_price > card_product.price -%}
              <s class="price price--compare">{{ card_product.compare_at_price | money }}</s>
            {%- endif -%}
          </div>

          {%- if card_product.available == false -%}
            <div class="card__badge">
              <span class="badge">{{ 'products.general.sold_out' | t }}</span>
            </div>
          {%- endif -%}
        </div>
      </div>
    </article>
  </div>
{%- endunless -%}
